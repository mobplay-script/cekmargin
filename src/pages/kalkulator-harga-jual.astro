---
import BaseLayout from "../layouts/BaseLayout.astro";
import HargaJualCalculator from "../components/HargaJualCalculator.tsx";

const faq = [
  {
    q: "Apa itu harga jual minimum?",
    a: "Harga jual paling rendah yang masih membuat Anda mencapai target untung setelah semua biaya. Menjual di bawah angka ini berarti untung Anda lebih kecil dari target, atau bahkan rugi.",
  },
  {
    q: "Fee marketplace diisi berapa?",
    a: "Gunakan tombol preset sebagai perkiraan awal, lalu sesuaikan dengan tarif terbaru toko Anda. Tarif berbeda per kategori dan dapat berubah sewaktu-waktu.",
  },
  {
    q: "Apakah hasil ini pasti akurat?",
    a: "Hasil adalah estimasi berdasarkan angka yang Anda masukkan. Biaya nyata bisa berbeda karena retur, refund, atau biaya tak terduga lain.",
  },
];
---

<BaseLayout
  title="Kalkulator Harga Jual Marketplace | Toolkit Seller Indonesia"
  description="Hitung harga jual minimum agar tetap untung setelah modal, biaya packing, fee marketplace, diskon, komisi affiliate, dan biaya iklan."
>
  <article class="grid gap-6">
    <header>
      <h1 class="text-2xl font-bold text-ink">
        Kalkulator Harga Jual Marketplace
      </h1>
      <p class="mt-2 text-secondary">
        Banyak seller menebak harga jual tanpa tahu batas amannya. Kalkulator ini
        menghitung perkiraan harga jual minimum agar Anda tetap untung setelah
        modal, biaya packing, fee marketplace, diskon, komisi affiliate, dan iklan.
      </p>
    </header>

    <HargaJualCalculator client:load />

    <section class="rounded-2xl bg-surface p-4 soft-shadow">
      <h2 class="text-lg font-semibold text-ink">Contoh perhitungan</h2>
      <p class="mt-2 text-sm text-secondary">
        Modal Rp20.000, packing Rp2.000, iklan Rp1.000, fee 8%, affiliate 0%,
        diskon 0%, target untung 15%. Total biaya tetap = Rp23.000. Harga jual
        minimum = 23.000 ÷ (1 − 0,08 − 0,15) = 23.000 ÷ 0,77 ≈
        <strong>Rp29.870</strong>. Pada harga itu untung bersih ≈ Rp4.480.
      </p>
    </section>

    <section class="rounded-2xl bg-surface p-4 soft-shadow">
      <h2 class="text-lg font-semibold text-ink">Kesalahan umum</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-secondary">
        <li>Lupa memasukkan biaya packing dan iklan ke dalam hitungan.</li>
        <li>Mengira fee marketplace dihitung dari modal, padahal dari harga jual.</li>
        <li>Memakai harga jual minimum sebagai harga akhir tanpa cadangan untuk retur.</li>
        <li>Tidak memperbarui angka fee saat marketplace mengubah tarif.</li>
      </ul>
    </section>

    <section class="rounded-2xl bg-primary-container p-5 text-center soft-shadow">
      <h2 class="text-lg font-semibold text-on-primary">
        Mau mencatat profit semua produk?
      </h2>
      <p class="mt-1 mb-3 text-sm text-on-primary-container">
        Bundle Template Seller Marketplace membantu Anda mencatat profit per
        produk, stok, dan laporan penjualan bulanan.
      </p>
      <a
        href="/template"
        class="inline-flex items-center gap-1 rounded-lg bg-surface px-5 py-2.5 text-sm font-semibold text-primary"
        data-ga-event="cta_template_diklik"
        data-ga-lokasi="kalkulator-harga-jual"
      >
        Lihat template
        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
      </a>
    </section>

    <section>
      <h2 class="mb-2 text-lg font-semibold text-ink">Pertanyaan umum</h2>
      <div class="grid gap-2">
        {
          faq.map((item) => (
            <details class="rounded-lg border border-outline-variant bg-surface p-3">
              <summary class="cursor-pointer text-sm font-semibold text-ink">
                {item.q}
              </summary>
              <p class="mt-2 text-sm text-secondary">{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </article>
</BaseLayout>
