---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterForm from "../components/NewsletterForm.tsx";

const isiBundle = [
  "Template profit per produk",
  "Template stok barang",
  "Template laporan penjualan",
  "Template simulasi diskon",
  "Template simulasi affiliate",
  "Template target omzet bulanan",
  "Template profit per SKU",
  "Template laporan bulanan sederhana",
];

const paket = [
  {
    nama: "Template Mini",
    harga: "Rp19.000",
    desc: "Satu template inti untuk mulai mencatat profit.",
    isi: ["Template profit per produk"],
    sorot: false,
  },
  {
    nama: "Bundle Basic",
    harga: "Rp49.000",
    desc: "Template dasar untuk mencatat profit dan stok.",
    isi: [
      "Template profit per produk",
      "Template stok barang",
      "Template laporan penjualan",
    ],
    sorot: false,
  },
  {
    nama: "Bundle Lengkap",
    harga: "Rp99.000",
    desc: "Semua 8 template untuk seller yang serius.",
    isi: ["Semua 8 template di atas"],
    sorot: true,
  },
  {
    nama: "Bundle Premium + Video",
    harga: "Rp199.000",
    desc: "Bundle lengkap plus video panduan pemakaian.",
    isi: ["Semua 8 template", "Video panduan pemakaian"],
    sorot: false,
  },
];
---

<BaseLayout
  title="Bundle Template Seller Marketplace | Toolkit Seller Indonesia"
  description="Template Google Sheets untuk mencatat profit per produk, stok barang, dan laporan penjualan marketplace. Mulai dari Rp19.000."
  activeNav="template"
>
  <article class="grid gap-6">
    <header class="text-center">
      <h1 class="text-2xl font-bold text-ink">
        Bundle Template Seller Marketplace
      </h1>
      <p class="mt-2 text-secondary">
        Kalkulator membantu Anda menghitung sebelum jualan. Template membantu
        Anda mencatat dan memantau hasilnya tiap hari. Semua template berformat
        Google Sheets — tinggal salin dan isi.
      </p>
    </header>

    <section class="rounded-2xl bg-surface p-4 soft-shadow">
      <h2 class="text-lg font-semibold text-ink">Isi lengkap bundle</h2>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {
          isiBundle.map((item) => (
            <li class="flex items-center gap-2 text-sm text-secondary">
              <span class="material-symbols-outlined fill text-[18px] text-primary">
                check_circle
              </span>
              {item}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="grid gap-4 sm:grid-cols-2">
      {
        paket.map((p) => (
          <div
            class:list={[
              "flex flex-col rounded-2xl bg-surface p-4 soft-shadow",
              p.sorot
                ? "border-2 border-primary-container"
                : "border border-outline-variant",
            ]}
          >
            {p.sorot && (
              <span class="mb-1 inline-flex w-max items-center gap-1 rounded-full bg-primary-container px-2.5 py-0.5 text-xs font-semibold text-on-primary-container">
                Paling lengkap
              </span>
            )}
            <h3 class="text-base font-semibold text-ink">{p.nama}</h3>
            <p class="mt-1 text-2xl font-bold text-primary">{p.harga}</p>
            <p class="mt-1 text-sm text-secondary">{p.desc}</p>
            <ul class="mt-3 mb-4 grid flex-grow gap-1.5">
              {p.isi.map((i) => (
                <li class="flex items-center gap-2 text-sm text-secondary">
                  <span class="material-symbols-outlined text-[18px] text-primary">
                    done
                  </span>
                  {i}
                </li>
              ))}
            </ul>
            <span
              class:list={[
                "mt-auto rounded-lg py-3 text-center text-sm font-semibold",
                p.sorot
                  ? "bg-primary-container text-on-primary-container"
                  : "border border-outline-variant text-ink-soft",
              ]}
            >
              Segera hadir
            </span>
          </div>
        ))
      }
    </section>

    <p class="text-sm text-ink-soft">
      Tombol pembelian akan aktif setelah halaman pembayaran (mis. Lynk.id atau
      Gumroad) terhubung. Daftar di bawah agar mendapat kabar saat bundle rilis.
    </p>

    <section class="rounded-2xl bg-primary-container p-6 text-center soft-shadow">
      <span class="material-symbols-outlined fill mb-2 text-3xl text-on-primary">
        mail
      </span>
      <h2 class="text-lg font-semibold text-on-primary">
        Dapatkan template gratis lebih dulu
      </h2>
      <p class="mx-auto mt-1 mb-4 max-w-sm text-sm text-on-primary-container">
        Daftar email Anda untuk menerima satu template profit gratis dan kabar
        saat bundle lengkap rilis.
      </p>
      <div class="mx-auto max-w-md">
        <NewsletterForm client:load />
      </div>
    </section>
  </article>
</BaseLayout>
