---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterForm from "../components/NewsletterForm.tsx";

const tools = [
  {
    href: "/kalkulator-harga-jual",
    nama: "Kalkulator Harga Jual",
    desc: "Cari harga jual minimum agar tetap untung setelah modal, fee, diskon, dan iklan.",
  },
  {
    href: "/kalkulator-diskon-aman",
    nama: "Kalkulator Diskon Aman",
    desc: "Cek apakah diskon promo masih untung, dan sampai berapa persen diskon masih aman.",
  },
  {
    href: "/kalkulator-iklan-profit",
    nama: "Kalkulator Iklan vs Profit",
    desc: "Hitung untung bersih setelah biaya iklan. Omzet naik belum tentu untung naik.",
  },
];
---

<BaseLayout
  title="Kalkulator Seller Marketplace Indonesia | Toolkit Seller Indonesia"
  description="Hitung harga jual, diskon, komisi, iklan, dan profit bersih sebelum ikut promo. Kalkulator gratis untuk seller Shopee, Tokopedia, dan TikTok Shop."
>
  <section class="mb-8">
    <h1 class="text-2xl font-bold text-slate-900 sm:text-3xl">
      Kalkulator Seller Marketplace Indonesia
    </h1>
    <p class="mt-3 text-slate-600">
      Hitung harga jual, diskon, komisi, iklan, dan profit bersih sebelum ikut
      promo atau menjual produk. Bantu Anda tahu: produk ini benar-benar untung
      atau cuma ramai order?
    </p>
  </section>

  <section class="grid gap-4">
    {
      tools.map((t) => (
        <a
          href={t.href}
          class="block rounded-xl border border-slate-200 bg-white p-4 transition hover:border-teal-400 hover:shadow-sm"
        >
          <h2 class="text-base font-semibold text-teal-700">{t.nama}</h2>
          <p class="mt-1 text-sm text-slate-600">{t.desc}</p>
          <span class="mt-2 inline-block text-sm font-medium text-teal-600">
            Buka kalkulator →
          </span>
        </a>
      ))
    }
  </section>

  <section class="mt-8 rounded-xl border border-slate-200 bg-white p-4">
    <h2 class="text-base font-semibold text-slate-900">
      Kenapa perlu menghitung dulu?
    </h2>
    <p class="mt-2 text-sm text-slate-600">
      Banyak seller merasa omzet besar, tetapi uang tidak terkumpul. Penyebabnya
      sering: salah hitung biaya admin, lupa biaya packing, terlalu agresif ikut
      promo, atau biaya iklan menggerus margin. Semua kalkulator di sini gratis,
      menampilkan rumusnya, dan bisa Anda isi dengan angka toko Anda sendiri.
    </p>
  </section>

  <section class="mt-4 grid gap-3 sm:grid-cols-2">
    <a
      href="/artikel"
      class="block rounded-xl border border-slate-200 bg-white p-4 transition hover:border-teal-400 hover:shadow-sm"
    >
      <h2 class="text-base font-semibold text-teal-700">Panduan Seller</h2>
      <p class="mt-1 text-sm text-slate-600">
        Artikel praktis cara hitung harga jual, diskon, dan profit iklan.
      </p>
    </a>
    <a
      href="/template"
      class="block rounded-xl border border-slate-200 bg-white p-4 transition hover:border-teal-400 hover:shadow-sm"
      data-ga-event="cta_template_diklik"
      data-ga-lokasi="homepage"
    >
      <h2 class="text-base font-semibold text-teal-700">Template Seller</h2>
      <p class="mt-1 text-sm text-slate-600">
        Template Google Sheets untuk mencatat profit, stok, dan laporan.
      </p>
    </a>
  </section>

  <section class="mt-4 rounded-xl border border-teal-200 bg-teal-50 p-4">
    <h2 class="text-base font-semibold text-teal-800">
      Dapatkan template profit gratis
    </h2>
    <p class="mt-1 mb-3 text-sm text-teal-700">
      Daftar email Anda untuk menerima template profit per produk gratis dan
      kabar tool baru.
    </p>
    <NewsletterForm client:load />
  </section>
</BaseLayout>
