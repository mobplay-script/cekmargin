---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterForm from "../components/NewsletterForm.tsx";

const tools = [
  {
    href: "/kalkulator-harga-jual",
    nama: "Kalkulator Harga Jual",
    desc: "Cari harga jual minimum agar tetap untung setelah modal, fee, diskon, dan iklan.",
    icon: "calculate",
  },
  {
    href: "/kalkulator-diskon-aman",
    nama: "Kalkulator Diskon Aman",
    desc: "Cek apakah diskon promo masih untung, dan sampai berapa persen diskon masih aman.",
    icon: "percent",
  },
  {
    href: "/kalkulator-iklan-profit",
    nama: "Kalkulator Iklan vs Profit",
    desc: "Hitung untung bersih setelah biaya iklan. Omzet naik belum tentu untung naik.",
    icon: "trending_up",
  },
];

const sumber = [
  {
    href: "/artikel",
    nama: "Panduan Seller",
    desc: "Artikel praktis cara hitung harga jual, diskon, dan profit iklan.",
    icon: "menu_book",
  },
  {
    href: "/template",
    nama: "Template Seller",
    desc: "Template Google Sheets untuk mencatat profit, stok, dan laporan.",
    icon: "description",
    ga: true,
  },
];
---

<BaseLayout
  title="Kalkulator Seller Marketplace Indonesia | Toolkit Seller Indonesia"
  description="Hitung harga jual, diskon, komisi, iklan, dan profit bersih sebelum ikut promo. Kalkulator gratis untuk seller Shopee, Tokopedia, dan TikTok Shop."
  activeNav="beranda"
>
  <section class="py-6 text-center">
    <h1 class="text-3xl font-bold tracking-tight text-ink">
      Kalkulator Seller Marketplace Indonesia
    </h1>
    <p class="mx-auto mt-3 max-w-xl text-secondary">
      Hitung harga jual, diskon, komisi, iklan, dan profit bersih sebelum ikut
      promo atau menjual produk. Bantu Anda tahu: produk ini benar-benar untung
      atau cuma ramai order?
    </p>
  </section>

  <section class="mb-8">
    <h2 class="mb-3 text-xl font-bold text-ink">Kalkulator Favorit</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        tools.map((t) => (
          <a
            href={t.href}
            class="flex flex-col rounded-2xl bg-surface p-4 soft-shadow transition hover:-translate-y-0.5"
          >
            <div class="mb-2 flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-surface-low">
                <span class="material-symbols-outlined text-primary">
                  {t.icon}
                </span>
              </span>
              <h3 class="text-base font-semibold text-ink">{t.nama}</h3>
            </div>
            <p class="mb-3 text-sm text-secondary">{t.desc}</p>
            <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-primary">
              Buka kalkulator
              <span class="material-symbols-outlined text-[16px]">
                arrow_forward
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mb-8">
    <h2 class="mb-3 text-xl font-bold text-ink">Sumber Belajar</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        sumber.map((s) => (
          <a
            href={s.href}
            class="flex items-start gap-3 rounded-2xl bg-surface p-4 soft-shadow transition hover:-translate-y-0.5"
            data-ga-event={s.ga ? "cta_template_diklik" : undefined}
            data-ga-lokasi={s.ga ? "homepage" : undefined}
          >
            <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-secondary-container">
              <span class="material-symbols-outlined text-on-secondary-container">
                {s.icon}
              </span>
            </span>
            <div>
              <h3 class="text-base font-semibold text-ink">{s.nama}</h3>
              <p class="mt-1 text-sm text-secondary">{s.desc}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section
    class="mb-8 rounded-2xl bg-primary-container p-6 text-center soft-shadow"
  >
    <span class="material-symbols-outlined fill mb-2 text-3xl text-on-primary">
      mail
    </span>
    <h2 class="text-xl font-bold text-on-primary">
      Dapatkan template profit gratis
    </h2>
    <p class="mx-auto mt-1 mb-4 max-w-sm text-sm text-on-primary-container">
      Daftar email Anda untuk menerima template profit per produk gratis dan
      kabar tool baru.
    </p>
    <div class="mx-auto max-w-md">
      <NewsletterForm client:load />
    </div>
  </section>
</BaseLayout>
