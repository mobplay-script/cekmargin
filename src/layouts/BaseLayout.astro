---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  activeNav?: "beranda" | "panduan" | "template";
}

const { title, description, activeNav } = Astro.props;
const siteName = "Toolkit Seller Indonesia";
const GA4_ID = import.meta.env.PUBLIC_GA4_ID;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const navItems = [
  { id: "beranda", label: "Beranda", href: "/", icon: "home" },
  { id: "panduan", label: "Panduan", href: "/artikel", icon: "menu_book" },
  { id: "template", label: "Template", href: "/template", icon: "description" },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#006565" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0&display=swap"
      rel="stylesheet"
    />
    {
      GA4_ID && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}
          />
          <script is:inline define:vars={{ GA4_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag("js", new Date());
            gtag("config", GA4_ID);
          </script>
        </>
      )
    }
  </head>
  <body class="bg-background text-ink pb-24 md:pb-0">
    <header class="sticky top-0 z-40 border-b border-surface-variant bg-surface">
      <div
        class="mx-auto flex max-w-3xl items-center justify-between gap-3 px-4 py-3"
      >
        <a href="/" class="flex items-center gap-2">
          <span class="material-symbols-outlined fill text-primary">
            storefront
          </span>
          <span class="text-base font-bold text-primary">{siteName}</span>
        </a>
        <nav class="hidden gap-4 text-sm text-ink-soft md:flex">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "hover:text-primary",
                  { "font-semibold text-primary": activeNav === item.id },
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-4 py-6">
      <slot />
    </main>

    <footer class="border-t border-surface-variant bg-surface">
      <div class="mx-auto max-w-3xl px-4 py-6 text-sm text-ink-soft">
        <p class="mb-2 font-semibold text-ink">{siteName}</p>
        <p class="mb-2">
          Kalkulator untuk membantu seller marketplace Indonesia menghitung
          untung sebelum jualan.
        </p>
        <p>
          Semua hasil adalah estimasi berdasarkan angka yang Anda masukkan, bukan
          jaminan keuntungan. Biaya marketplace dapat berubah sewaktu-waktu.
        </p>
      </div>
    </footer>

    <nav
      class="fixed bottom-0 left-0 z-50 flex h-20 w-full items-center justify-around border-t border-surface-variant bg-surface md:hidden"
    >
      {
        navItems.map((item) => {
          const active = activeNav === item.id;
          return (
            <a
              href={item.href}
              class:list={[
                "flex flex-1 flex-col items-center justify-center gap-1 py-2",
                active ? "text-primary" : "text-ink-soft",
              ]}
            >
              <span
                class:list={[
                  "flex h-8 w-16 items-center justify-center rounded-full transition-colors",
                  active ? "bg-secondary-container" : "",
                ]}
              >
                <span
                  class:list={["material-symbols-outlined", { fill: active }]}
                >
                  {item.icon}
                </span>
              </span>
              <span class="text-xs font-medium">{item.label}</span>
            </a>
          );
        })
      }
    </nav>

    <script is:inline>
      // Mencatat klik pada elemen ber-atribut data-ga-event ke GA4.
      document.addEventListener("click", function (e) {
        var el = e.target.closest("[data-ga-event]");
        if (el && typeof window.gtag === "function") {
          window.gtag("event", el.dataset.gaEvent, {
            lokasi: el.dataset.gaLokasi || "",
          });
        }
      });
    </script>
  </body>
</html>
